# Copy to .env next to docker-compose.yml.
# The key apps (and Open WebUI) use to talk to the gateway. Any long random text.
PROXY_API_KEY=change-me-to-something-long-and-random
# Optional: a separate password for the gateway page (defaults to the proxy key).
# ADMIN_PASSWORD=
# Provider keys (add _2, _3... to rotate several keys for one provider):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
