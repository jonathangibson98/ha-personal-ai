# Personal AI Gateway as a normal Docker container (no Home Assistant add-on needed).
FROM python:3.12-alpine
RUN pip install --no-cache-dir "aiohttp>=3.9,<4"
COPY app /app
ENV DATA_DIR=/data PYTHONUNBUFFERED=1 PORT=8000
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8000/health >/dev/null || exit 1
CMD ["python", "/app/server.py"]
